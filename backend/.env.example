# Copy this file to .env.local and fill the values.

# ---- Supabase (Project Settings in the Supabase dashboard) ----
# Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # SECRET - server only, never put in frontend code
SUPABASE_BUCKET=hotel-images
# Project Settings > Database > Connection string (URI). Supabase needs SSL, so keep DB_SSL=true
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
DB_SSL=true

# secret used to sign the temporary guest session (any long random text)
GUEST_JWT_SECRET=change-this-guest-secret

# website URL; the QR code opens  GUEST_BASE_URL/g/<token>
GUEST_BASE_URL=https://yourdomain.com
# only needed if the frontend runs on a DIFFERENT domain than this API (comma separated)
CORS_ORIGINS=http://localhost:3000

# first admin user (created by: npm run setup)
ADMIN_EMAIL=admin@hotel.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Hotel Admin
