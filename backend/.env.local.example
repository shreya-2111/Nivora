# ==============================================================================
# NIVORA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env.local and populate the values below.
# DO NOT commit .env.local to Git.
# ==============================================================================

# ---- Supabase API Credentials ----
# Located in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_BUCKET=hotel-images

# ---- PostgreSQL Database Connection ----
# Located in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Ensure port is 5432 or 6543 (transaction pooler) and contains your real DB password.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
DB_SSL=true

# ---- Guest Session Security ----
# Cryptographically secure random secret string used to sign 12-hour guest JWT tokens
GUEST_JWT_SECRET=replace-with-a-secure-random-32-byte-hex-or-base64-string

# ---- Application URLs & CORS ----
# Website base URL encoded into QR codes for guest room direct resolution
GUEST_BASE_URL=http://localhost:3000
# Comma-separated allowed frontend origins for CORS proxy preflights and headers
CORS_ORIGINS=http://localhost:3000

# ---- Initial Hotel Administrator Bootstrap (npm run setup) ----
# Seed staff credentials created in Supabase Auth & admin_users table upon setup
ADMIN_EMAIL=concierge.admin@nivora.resorts
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword123!
ADMIN_NAME=Nivora Concierge Desk
